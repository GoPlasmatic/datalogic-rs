[
    "# DateTime creation and parsing",
    {
        "description": "Create a datetime from string",
        "rule": {"datetime": "2022-07-06T13:20:06Z"},
        "data": null,
        "result": "2022-07-06T13:20:06Z"
    },
    {
        "description": "parse_date with format string",
        "rule": {"parse_date": ["2022-07-06", "yyyy-MM-dd"]},
        "data": null,
        "result": "2022-07-06T00:00:00Z"
    },
    {
        "description": "format_date with format string",
        "rule": {"format_date": [{"datetime": "2022-07-06T13:20:06Z"}, "yyyy-MM-dd"]},
        "data": null,
        "result": "2022-07-06"
    },
    {
        "description": "format_date with timezone offset (z format)",
        "rule": {"format_date": [{"datetime": "2022-07-06T13:20:06+05:00"}, "z"]},
        "data": null,
        "result": "+0500"
    },

    "# DateTime comparisons",
    {
        "description": "Equal datetimes",
        "rule": {"==": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Not equal datetimes",
        "rule": {"==": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-07T13:20:06Z"}
        ]},
        "data": null,
        "result": false
    },
    {
        "description": "Strict equal datetimes",
        "rule": {"===": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Not strict equal datetimes",
        "rule": {"!==": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-07T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Greater than comparison for datetimes",
        "rule": {">": [
            {"datetime": "2022-07-07T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Less than comparison for datetimes",
        "rule": {"<": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-07T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Greater than or equal comparison for datetimes",
        "rule": {">=": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },
    {
        "description": "Less than or equal comparison for datetimes",
        "rule": {"<=": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"datetime": "2022-07-07T13:20:06Z"}
        ]},
        "data": null,
        "result": true
    },

    "# DateTime arithmetic operations",
    {
        "description": "Add duration to datetime",
        "rule": {"+": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"timestamp": "1d"}
        ]},
        "data": null,
        "result": "2022-07-07T13:20:06Z"
    },
    {
        "description": "Subtract duration from datetime",
        "rule": {"-": [
            {"datetime": "2022-07-06T13:20:06Z"},
            {"timestamp": "1d"}
        ]},
        "data": null,
        "result": "2022-07-05T13:20:06Z"
    },
    {
        "description": "Calculate duration between two datetimes",
        "rule": {"-": [
            {"datetime": "2022-07-07T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"}
        ]},
        "data": null,
        "result": "1d:0h:0m:0s"
    },
    {
        "description": "date_diff with days unit",
        "rule": {"date_diff": [
            {"datetime": "2022-07-07T13:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"},
            "days"
        ]},
        "data": null,
        "result": 1
    },
    {
        "description": "date_diff with hours unit",
        "rule": {"date_diff": [
            {"datetime": "2022-07-06T14:20:06Z"},
            {"datetime": "2022-07-06T13:20:06Z"},
            "hours"
        ]},
        "data": null,
        "result": 1
    },

    "# Using datetime with variables",
    {
        "description": "Compare datetime from variable",
        "rule": {">": [
            {"val": "current_date"},
            {"datetime": "2022-01-01T00:00:00Z"}
        ]},
        "data": {"current_date": {"datetime": "2022-07-06T13:20:06Z"}},
        "result": true
    },
    {
        "description": "Add duration to datetime from variable",
        "rule": {"+": [
            {"val": "start_date"},
            {"timestamp": "1d"}
        ]},
        "data": {"start_date": {"datetime": "2022-07-06T13:20:06Z"}},
        "result": "2022-07-07T13:20:06Z"
    },
    {
        "description": "date_diff with milliseconds unit",
        "rule": {
            "date_diff": [
                {
                    "datetime": "2024-01-01T00:00:01Z"
                },
                {
                    "datetime": "2024-01-01T00:00:00Z"
                },
                "milliseconds"
            ]
        },
        "data": null,
        "result": 1000
    },
    {
        "description": "date_diff with an unknown unit is an error, not 0",
        "rule": {
            "date_diff": [
                {
                    "datetime": "2024-01-08T00:00:00Z"
                },
                {
                    "datetime": "2024-01-01T00:00:00Z"
                },
                "weeks"
            ]
        },
        "data": null,
        "error": {
            "type": "date_diff: unknown unit \"weeks\" (expected days, hours, minutes, seconds, or milliseconds)"
        }
    },
    {
        "description": "format_date with an unknown raw chrono specifier is an error, not a panic",
        "rule": {"format_date": [{"datetime": "2024-01-01T00:00:00Z"}, "%Q"]},
        "data": null,
        "error": {"type": "Invalid date format"}
    },
    {
        "description": "format_date with a trailing lone % is an error, not a panic",
        "rule": {"format_date": [{"datetime": "2024-01-01T00:00:00Z"}, "abc%"]},
        "data": null,
        "error": {"type": "Invalid date format"}
    },
    {
        "description": "format_date with an unknown specifier and a timezone is an error, not a panic",
        "rule": {"format_date": [{"datetime": "2024-01-01T00:00:00Z"}, "%Q", "UTC"]},
        "data": null,
        "error": {"type": "Invalid date format"}
    },
    {
        "description": "format_date with a format string from data that has an unknown specifier",
        "rule": {"format_date": [{"datetime": "2024-01-01T00:00:00Z"}, {"var": "fmt"}]},
        "data": {"fmt": "yyyy %Q"},
        "error": {"type": "Invalid date format"}
    },
    "# A datetime / timestamp field inside an ordinary record is data, not a datetime",
    {
        "description": "=== tells apart two records that share only a datetime field",
        "rule": {"===": [{"var": "a"}, {"var": "b"}]},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, "b": {"datetime": "2024-01-01T00:00:00Z", "user": "bob"}},
        "result": false
    },
    {
        "description": "== tells apart two records that share only a datetime field",
        "rule": {"==": [{"var": "a"}, {"var": "b"}]},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, "b": {"datetime": "2024-01-01T00:00:00Z", "user": "bob"}},
        "result": false
    },
    {
        "description": "=== still matches identical records with a datetime field",
        "rule": {"===": [{"var": "a"}, {"var": "b"}]},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, "b": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}},
        "result": true
    },
    {
        "description": "in does not match a record by its datetime field alone",
        "rule": {"in": [{"var": "a"}, [{"var": "b"}]]},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, "b": {"datetime": "2024-01-01T00:00:00Z", "user": "bob"}},
        "result": false
    },
    {
        "description": "distinct keeps records that share only a datetime field",
        "rule": {"distinct": [{"var": "rows"}]},
        "data": {"rows": [{"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, {"datetime": "2024-01-01T00:00:00Z", "user": "bob"}]},
        "result": [{"datetime": "2024-01-01T00:00:00Z", "user": "alice"}, {"datetime": "2024-01-01T00:00:00Z", "user": "bob"}]
    },
    {
        "description": "type of a record with a datetime field is object",
        "rule": {"type": {"var": "a"}},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z", "user": "alice"}},
        "result": "object"
    },
    {
        "description": "type of a record with a timestamp field is object",
        "rule": {"type": {"var": "a"}},
        "data": {"a": {"timestamp": 123, "id": 1}},
        "result": "object"
    },
    {
        "description": "The single-key boundary form is still a datetime",
        "rule": {"type": {"var": "a"}},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z"}},
        "result": "datetime"
    },
    {
        "description": "The single-key boundary form still compares as an instant",
        "rule": {"===": [{"var": "a"}, {"var": "b"}]},
        "data": {"a": {"datetime": "2024-01-01T00:00:00Z"}, "b": {"datetime": "2024-01-01T02:00:00+02:00"}},
        "result": true
    },
    {
        "description": "The single-key duration boundary form is still a duration",
        "rule": {"type": {"var": "a"}},
        "data": {"a": {"timestamp": "1d"}},
        "result": "duration"
    }
]
