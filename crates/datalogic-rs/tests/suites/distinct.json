[
  "# distinct operator tests (ext-array)",
  {
    "description": "Dedup numbers, first occurrence wins",
    "rule": { "distinct": [{"val": "nums"}] },
    "data": { "nums": [3, 1, 3, 2, 1] },
    "result": [3, 1, 2]
  },
  {
    "description": "Dedup strings",
    "rule": { "distinct": [{"val": "tags"}] },
    "data": { "tags": ["a", "b", "a", "c", "b"] },
    "result": ["a", "b", "c"]
  },
  {
    "description": "Strict equality: number and numeric string stay distinct",
    "rule": { "distinct": [{"val": "mixed"}] },
    "data": { "mixed": [1, "1", 1, true] },
    "result": [1, "1", true]
  },
  {
    "description": "Deep object dedup",
    "rule": { "distinct": [{"val": "items"}] },
    "data": { "items": [{"a": 1, "b": 2}, {"a": 1, "b": 3}, {"b": 2, "a": 1}] },
    "result": [{"a": 1, "b": 2}, {"a": 1, "b": 3}]
  },
  {
    "description": "Deep array dedup",
    "rule": { "distinct": [{"val": "items"}] },
    "data": { "items": [[1, 2], [1, 3], [1, 2]] },
    "result": [[1, 2], [1, 3]]
  },
  {
    "description": "All-literal input (constant-folding path)",
    "rule": { "distinct": [[1, 1, 2, 3, 2]] },
    "data": null,
    "result": [1, 2, 3]
  },
  "# Keyed form",
  {
    "description": "Dedup by field keeps first full element",
    "rule": { "distinct": [{"val": "items"}, {"var": "id"}] },
    "data": { "items": [
      {"id": 1, "rev": "a"},
      {"id": 2, "rev": "b"},
      {"id": 1, "rev": "c"}
    ]},
    "result": [{"id": 1, "rev": "a"}, {"id": 2, "rev": "b"}]
  },
  {
    "description": "Dedup by computed key",
    "rule": { "distinct": [{"val": "nums"}, {"%": [{"var": ""}, 3]}] },
    "data": { "nums": [1, 4, 2, 7, 3] },
    "result": [1, 2, 3]
  },
  {
    "description": "Dedup by object-valued key",
    "rule": { "distinct": [{"val": "items"}, {"var": "loc"}] },
    "data": { "items": [
      {"id": 1, "loc": {"city": "Chennai"}},
      {"id": 2, "loc": {"city": "Pune"}},
      {"id": 3, "loc": {"city": "Chennai"}}
    ]},
    "result": [
      {"id": 1, "loc": {"city": "Chennai"}},
      {"id": 2, "loc": {"city": "Pune"}}
    ]
  },
  "# Edge cases",
  {
    "description": "Empty array yields empty result",
    "rule": { "distinct": [{"val": "nums"}] },
    "data": { "nums": [] },
    "result": []
  },
  {
    "description": "Null input yields empty result",
    "rule": { "distinct": [{"val": "missing"}] },
    "data": {},
    "result": []
  },
  {
    "description": "No duplicates passes through unchanged",
    "rule": { "distinct": [{"val": "nums"}] },
    "data": { "nums": [1, 2, 3] },
    "result": [1, 2, 3]
  },
  "# Error cases",
  {
    "description": "Scalar input is an error",
    "rule": { "distinct": [{"val": "n"}] },
    "data": { "n": 42 },
    "error": { "type": "Invalid Arguments" }
  },
  {
    "description": "Object input is an error",
    "rule": { "distinct": [{"val": "obj"}] },
    "data": { "obj": {"a": 1} },
    "error": { "type": "Invalid Arguments" }
  }
]
