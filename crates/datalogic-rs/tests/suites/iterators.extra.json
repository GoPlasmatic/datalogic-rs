  "A missing field is var's implicit null in a strict comparison, on every path",
  {
    "description": "filter === null keeps items missing the field",
    "rule": {
      "filter": [
        {
          "var": "xs"
        },
        {
          "===": [
            {
              "var": "v"
            },
            null
          ]
        }
      ]
    },
    "data": {
      "xs": [
        {
          "v": 1
        },
        {
          "w": 2
        },
        {
          "v": null
        }
      ]
    },
    "result": [
      {
        "w": 2
      },
      {
        "v": null
      }
    ]
  },
