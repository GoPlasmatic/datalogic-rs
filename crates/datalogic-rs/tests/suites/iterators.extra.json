  "Filter invariant-hoisting regressions. The strict-eq filter fast path evaluates a hoisted operand before the loop, one frame shallower than the predicate's static depth, so an operand may only be hoisted when it resolves to the same frame at either depth - i.e. when it binds to the root. Each case below diverged from the general path before that rule was enforced through the compile-time scope binding.",
  {
    "description": "Filter predicate reading the iteration index must not be hoisted",
    "rule": {
      "filter": [
        {
          "var": "xs"
        },
        {
          "===": [
            {
              "var": "a"
            },
            {
              "val": [
                [
                  1
                ],
                "index"
              ]
            }
          ]
        }
      ]
    },
    "data": {
      "xs": [
        {
          "a": 0
        },
        {
          "a": 1
        },
        {
          "a": 2
        }
      ]
    },
    "result": [
      {
        "a": 0
      },
      {
        "a": 1
      },
      {
        "a": 2
      }
    ]
  },
  {
    "description": "Filter predicate reading the iteration key must not be hoisted",
    "rule": {
      "filter": [
        {
          "var": "xs"
        },
        {
          "===": [
            {
              "var": "a"
            },
            {
              "val": [
                [
                  1
                ],
                "key"
              ]
            }
          ]
        }
      ]
    },
    "data": {
      "xs": [
        {
          "a": 0
        },
        {
          "a": 1
        }
      ]
    },
    "result": []
  },
