[
    "A proposal for handling scopes",
    {
        "description": "Map can add each number to index",
        "rule": {
            "map": [
                {
                    "val": "numbers"
                },
                {
                    "+": [
                        {
                            "val": [
                                [
                                    1
                                ],
                                "index"
                            ]
                        },
                        {
                            "val": []
                        }
                    ]
                }
            ]
        },
        "data": {
            "numbers": [
                1,
                2,
                3
            ]
        },
        "result": [
            1,
            3,
            5
        ]
    },
    {
        "description": "Map can add each number to value from context",
        "rule": {
            "map": [
                {
                    "val": "numbers"
                },
                {
                    "+": [
                        {
                            "val": [
                                [
                                    2
                                ],
                                "value"
                            ]
                        },
                        {
                            "val": []
                        }
                    ]
                }
            ]
        },
        "data": {
            "numbers": [
                1,
                2,
                3
            ],
            "value": 10
        },
        "result": [
            11,
            12,
            13
        ]
    },
    {
        "description": "Filter can use parent context to filter",
        "rule": {
            "filter": [
                {
                    "val": "people"
                },
                {
                    "===": [
                        {
                            "val": "department"
                        },
