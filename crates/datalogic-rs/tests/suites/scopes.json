                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "data": {
            "tag": "ROOT",
            "a": [
                {
                    "tag": "A",
                    "b": [
                        {
                            "tag": "B",
                            "c": [
                                {
                                    "tag": "C"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "result": [
            [
                [
                    "C"
                ]
            ]
        ]
    },
    {
