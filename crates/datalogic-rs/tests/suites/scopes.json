    "Interior-frame addressing at three levels of nesting. Frames are [A, B, C] with C current; only these cases reach the ScopeBinding::Ancestor branch, which no other suite exercises.",
    {
        "description": "Depth 3: [[0]] reads the current frame",
        "rule": {
            "map": [
                {
                    "val": "a"
                },
                {
                    "map": [
                        {
                            "val": "b"
                        },
                        {
                            "map": [
                                {
                                    "val": "c"
                                },
                                {
                                    "val": [
                                        [
                                            0
                                        ],
                                        "tag"
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "data": {
            "tag": "ROOT",
            "a": [
                {
                    "tag": "A",
                    "b": [
                        {
                            "tag": "B",
                            "c": [
                                {
                                    "tag": "C"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "result": [
            [
                [
                    "C"
                ]
            ]
        ]
    },
    {
        "description": "Depth 3: [[1]] aliases [[0]] and also reads the current frame",
        "rule": {
            "map": [
                {
                    "val": "a"
                },
                {
                    "map": [
                        {
                            "val": "b"
                        },
