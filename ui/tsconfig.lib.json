{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "moduleDetection": "force",
    "jsx": "react-jsx",

    /* Declaration generation */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases: mirror vite.lib.config.ts so the dts build resolves the
       WASM dep to the vendored copy (refreshed by `sync-wasm`) rather than
       the node_modules pin, which tracks the last published version. */
    "paths": {
      "@/*": ["./src/*"],
      "@logic-editor/*": ["./src/components/logic-editor/*"],
      "@goplasmatic/datalogic-wasm": ["./vendor/datalogic"]
    }
  },
  "include": [
    "src/css.d.ts",
    "src/lib.ts",
    "src/components/logic-editor/**/*"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/hooks/**/*",
    "src/contexts/**/*",
    "src/components/debug-panel/**/*",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
