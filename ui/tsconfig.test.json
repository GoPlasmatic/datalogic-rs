{
  // Type-checks tests/ (Vitest strips types without checking them). The
  // tests under src/**/__tests__ are covered by tsconfig.app.json.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@logic-editor/*": ["./src/components/logic-editor/*"],
      "@goplasmatic/datalogic-wasm/nodejs": ["./vendor/datalogic/nodejs/datalogic_wasm.d.ts"],
      "@goplasmatic/datalogic-wasm": ["./vendor/datalogic"]
    }
  },
  "include": ["tests", "src/css.d.ts"]
}
